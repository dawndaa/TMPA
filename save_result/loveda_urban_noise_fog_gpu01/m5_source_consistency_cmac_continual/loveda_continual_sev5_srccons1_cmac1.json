    "stabilization": {
      "source_consistency": {
        "enabled": true,
        "weight": 1.0,
        "definition": "DAF-style symmetric KL against frozen source prediction"
      },
      "prompt_feature_consistency": {
        "enabled": false,
        "weight": 1.0,
        "type": "cosine",
        "definition": "TMPA prompt/text-space counterpart to DAF visual feature consistency; DAF visual feature consistency is not copied directly because TMPA freezes visual features"
      },
      "cmac": {
        "enabled": true,
        "weight": 1.0,
        "definition": "DAF-style directional source anchoring mapped to TMPA pixel class probabilities: penalize moving away from the frozen-source assigned class or toward non-anchor classes"
      },
      "safs": {
        "enabled": false,
        "alpha": 0.5,
        "window": 32,
        "warmup": 8,
        "definition": "Streaming analogue of DAF SAFS for strict batch-size-one CTTA: gate optimizer updates using prediction drift against a frozen source anchor and a rolling mean - alpha * std threshold"
      }
    }
  },
